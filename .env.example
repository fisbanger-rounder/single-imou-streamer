# Imou Open Platform credentials (https://open.imoulife.com -> Control Board -> My App)
IMOU_APP_ID=lcxxxxxxxxxxxxxxxx
IMOU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin accessToken (At_...).
# Leave empty to let the server fetch one via the appId/appSecret.
IMOU_ACCESS_TOKEN=

# Data center base URL (must match where your app/account was registered):
#   East Asia (Singapore):    https://openapi-sg.easy4ip.com:443
#   Central Europe (Frankfurt): https://openapi-fk.easy4ip.com:443
#   Western America (Oregon): https://openapi-or.easy4ip.com:443
#   Mainland China:           https://openapi.lechange.cn
IMOU_BASE_URL=https://openapi-fk.easy4ip.com:443

# Server port
PORT=3000

# Optional HTTPS (needed for two-way talk when accessing from other machines,
# browsers only allow microphone on secure origins). Drop PEM files in ./certs:
TLS_CERT=./certs/cert.pem
TLS_KEY=./certs/key.pem
